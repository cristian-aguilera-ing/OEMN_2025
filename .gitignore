#===================================================================

# General & OS Specific

# ===================================================================

# Archivos de metadatos del sistema operativo

.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales y de respaldo del editor

*~
*.swp
*.swo

# ===================================================================

# Archivos de configuración de IDEs y editores

# ===================================================================

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# ===================================================================

# Logs y archivos de dependencias

# ===================================================================

#Archivos de log

*.log
logs
.log.

# Logs de gestores de paquetes

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de variables de entorno (¡Nunca subas secretos!)

.env
.env.*
!.env.example

# ===================================================================

# Backend (Node.js)

# ===================================================================

# Dependencias

backend/node_modules/

# Directorios de build (si usaras un transpilador como Babel/TypeScript)

backend/dist/
backend/build/
backend/.out/

# ===================================================================

# Frontend (React + Vite)

# ===================================================================

# Dependencias

frontend/node_modules/

# Directorio de build de Vite

frontend/dist/

# Archivos de caché y específicos de Vite

frontend/.vite/

# Reportes de tests y cobertura de código

frontend/coverage/
frontend/.nyc_output/

# ===================================================================

# Docker

# ===================================================================

# Ignorar archivos locales de Docker Compose que puedan sobreescribir configuraciones

docker-compose.override.yml
docker-compose.local.yml